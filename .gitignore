# Claude Code — réglages propres à la machine
.claude/settings.local.json

# Skills : contenu TIERS, et surtout des jonctions Windows qui pointent hors du
# dépôt (`.agents/skills/better-typography` → C:\Users\<moi>\.agents\...).
# Git les suivrait et publierait le contenu du dossier personnel. Leur
# provenance est enregistrée dans `skills-lock.json`, qui suffit à les refaire.
.agents/
.claude/skills/

# Windows / Git Bash
*.stackdump

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
